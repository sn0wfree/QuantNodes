# 端口由 CLI 注入环境变量 (PORT, HOST, API_PORT)
# 不设置 VITE_API_BASE_URL，使用默认的 /api 路径走 Vite proxy
API_PORT=19380

# v3.0.0 Stage 5.3: 显示 Agent Chat 入口（未装 [agent] extra 时会显示 install 提示页）
VITE_AGENT_ENABLED=true
# 指向 in-process nanobot gateway（FastAPI lifespan 启动时拉起）
VITE_NANOBOT_GATEWAY_URL=http://127.0.0.1:18090/
# v3.0.0 Stage 5.4: WebSocket bootstrap path（默认 /webui/bootstrap）
VITE_NANOBOT_BOOTSTRAP_PATH=/webui/bootstrap
