# LLM 配置
QUANTNODES__LLM__API_KEY=your-api-key-here
QUANTNODES__LLM__BASE_URL=https://api.openai.com/v1

# 模型配置
QUANTNODES__LLM__MODEL=gpt-4

# DuckDB (默认本地文件)
QUANTNODES__DUCKDB__PATH=data/quantnodes.db

# 可选数据源 (取消注释并配置)
# QUANTNODES__CLICKHOUSE__HOST=localhost
# QUANTNODES__CLICKHOUSE__PORT=8123
# QUANTNODES__CLICKHOUSE__USER=default
# QUANTNODES__CLICKHOUSE__PASSWORD=
# QUANTNODES__CLICKHOUSE__DATABASE=default

# QUANTNODES__MYSQL__HOST=localhost
# QUANTNODES__MYSQL__PORT=3306
# QUANTNODES__MYSQL__USER=root
# QUANTNODES__MYSQL__PASSWORD=
# QUANTNODES__MYSQL__DATABASE=quant

# 缓存配置
QUANTNODES__CACHE_ENABLED=true
QUANTNODES__CACHE_TTL=3600

# ============================================================
# v3.0.0 Stage 5.3 — nanobot agent 运行时（可选，需 pip install 'quantnodes[agent]'）
# ============================================================
# 单进程 gateway 端口：FastAPI uvicorn 跑在 19380，nanobot websocket + WebUI 跑在 18090
# 同一 Python 进程，无需额外端口管理
NANOBOT_GATEWAY_HOST=127.0.0.1
NANOBOT_GATEWAY_PORT=18090
# workspace 路径（相对当前工作目录），与 .agent/ 一致
NANOBOT_WORKSPACE=.agent

# ============================================================
# v3.0.0 Stage 5.4 — 渠道接入（飞书 / WebSocket）
# ============================================================
# WebSocket channel：默认启用（端口 = NANOBOT_GATEWAY_PORT）
# 仅当你想把它放到独立端口时才需要显式覆盖：
# NANOBOT_WEBSOCKET_PORT=18090

# 飞书 / Lark bot（使用 WebSocket 长连接，无需公网 IP 或 webhook）
# 在飞书开放平台 https://open.feishu.cn/ 创建应用并获取：
# - App ID 和 App Secret
# - 启用"机器人"能力
# - 事件订阅：im.message.receive_v1
# 同时安装 lark-oapi：
#   pip install lark-oapi
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选配置
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_DOMAIN=feishu        # 或 lark（国际版）
# FEISHU_GROUP_POLICY=mention # mention（仅 @机器人） 或 open（接收所有群消息）
# FEISHU_REPLY_TO_MESSAGE=false
# FEISHU_ALLOW_FROM=           # 逗号分隔的 open_id 白名单（空 = 全部允许）

# ============================================================
# v3.0.0 Stage 5.5 — 量化专属 Cron 任务（默认 Asia/Shanghai 时区）
# ============================================================
# 3 个 quant 系统任务由 QuantNodes.agent.cron_jobs 自动注册到 nanobot CronService：
#   - quant-daily-recap        — 工作日 16:30   因子IC重算+回测归档
#   - quant-weekly-review      — 周日 22:00      因子周报+风险归因
#   - quant-monthly-strategy-pool — 每月1日 02:00 Wiki增量+策略池评审
#
# 全部关闭 / 单独关闭 / 修改 cron 表达式（覆盖默认）：
# QUANTNODES__CRON__QUANT_DAILY_RECAP__ENABLED=false
# QUANTNODES__CRON__QUANT_DAILY_RECAP__CRON_EXPR="0 17 * * 1-5"
# QUANTNODES__CRON__QUANT_WEEKLY_REVIEW__ENABLED=false
# QUANTNODES__CRON__QUANT_WEEKLY_REVIEW__CRON_EXPR="0 23 * * 0"
# QUANTNODES__CRON__QUANT_MONTHLY_STRATEGY_POOL__ENABLED=false
# QUANTNODES__CRON__QUANT_MONTHLY_STRATEGY_POOL__DELIVER=false
# 完整替换消息提示词：
# QUANTNODES__CRON__QUANT_DAILY_RECAP__MESSAGE="自定义的日终复盘 prompt..."
#
# 查看 / 手动触发：
#   GET  /api/agent/cron            — 列出所有 cron 任务
#   GET  /api/agent/cron/<id>/run-now — 立即执行某个任务
