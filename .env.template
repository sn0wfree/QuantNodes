# LLM 配置
QUANTNODES__LLM__API_KEY=your-api-key-here
QUANTNODES__LLM__BASE_URL=https://api.openai.com/v1

# 模型配置
QUANTNODES__LLM__MODEL=gpt-4

# DuckDB (默认本地文件)
QUANTNODES__DUCKDB__PATH=data/quantnodes.db

# 可选数据源 (取消注释并配置)
# QUANTNODES__CLICKHOUSE__HOST=localhost
# QUANTNODES__CLICKHOUSE__PORT=8123
# QUANTNODES__CLICKHOUSE__USER=default
# QUANTNODES__CLICKHOUSE__PASSWORD=
# QUANTNODES__CLICKHOUSE__DATABASE=default

# QUANTNODES__MYSQL__HOST=localhost
# QUANTNODES__MYSQL__PORT=3306
# QUANTNODES__MYSQL__USER=root
# QUANTNODES__MYSQL__PASSWORD=
# QUANTNODES__MYSQL__DATABASE=quant

# 缓存配置
QUANTNODES__CACHE_ENABLED=true
QUANTNODES__CACHE_TTL=3600
